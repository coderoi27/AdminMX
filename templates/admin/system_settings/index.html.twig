{% extends 'base.html.twig' %}

{% block title %}Configuraciones | Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width: 1040px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif;">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Alpha Admin</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">Configuraciones del sistema</h1>
                <p style="margin:0.6rem 0 0; color:#4b5563; line-height:1.6;">
                    Ajustes operativos para Public y plugins sin tocar código ni archivos de entorno.
                </p>
            </div>
            <a href="{{ path('admin_dashboard') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">
                Volver al admin
            </a>
        </div>

        <section style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; margin-top:1.5rem; background:#fff;">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
                <div>
                    <p style="margin:0; color:#6b7280; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.06em;">Checklist duro</p>
                    <h2 style="margin:0.4rem 0 0; font-size:1.2rem; color:#111827;">Google Places Proxy</h2>
                    <p style="margin:0.45rem 0 0; color:#4b5563; line-height:1.6;">
                        Estado verificable del plugin. Al apagarlo, Public debe conservar el catálogo canónico, pero no ejecutar búsqueda ni consumir reglas operativas de Places.
                    </p>
                </div>
                <form action="{{ path('admin_system_plugins_toggle', { pluginKey: 'google_places_proxy' }) }}" method="POST" style="margin:0;">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_plugin_google_places_proxy') }}">
                    <input type="hidden" name="_redirect_route" value="admin_system_settings_index">
                    <button type="submit" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.35rem; border-radius:999px; padding:0.58rem 1rem; background:{{ places_plugin.isEnabled ? '#ef4444' : '#22c55e' }}; color:#fff; border:none; cursor:pointer; font-weight:800;">
                        {{ places_plugin.isEnabled ? 'Desactivar proxy Places' : 'Activar proxy Places' }}
                    </button>
                </form>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:0.8rem; margin-top:1rem;">
                <article style="border:1px solid #e5e7eb; border-radius:14px; padding:0.9rem; background:{{ places_plugin.isEnabled ? '#f0fdf4' : '#f8fafc' }};">
                    <span style="display:block; color:#64748b; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.06em; font-weight:800;">Estado runtime</span>
                    <strong style="display:block; margin-top:0.3rem; color:{{ places_plugin.isEnabled ? '#166534' : '#475569' }}; font-size:1.1rem;">{{ places_plugin.isEnabled ? 'Encendido' : 'Apagado' }}</strong>
                    <small style="display:block; margin-top:0.35rem; color:#64748b;">Status interno: {{ places_plugin.status }}</small>
                </article>
                {% for item in places_checklist %}
                    <article style="border:1px solid #e5e7eb; border-radius:14px; padding:0.9rem; background:#fff;">
                        <span style="display:inline-flex; border-radius:999px; padding:0.24rem 0.55rem; background:{{ item.enabled ? '#dcfce7' : '#f3f4f6' }}; color:{{ item.enabled ? '#166534' : '#475569' }}; font-size:0.72rem; font-weight:900; text-transform:uppercase;">
                            {{ item.enabled ? 'Activo' : 'Inactivo' }}
                        </span>
                        <strong style="display:block; margin-top:0.55rem; color:#111827;">{{ item.label }}</strong>
                        <p style="margin:0.35rem 0 0; color:#4b5563; line-height:1.5; font-size:0.9rem;">
                            {{ places_plugin.isEnabled ? item.on : item.off }}
                        </p>
                    </article>
                {% endfor %}
            </div>
        </section>

        <section style="display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:1.2rem; margin-top:1.5rem;">
            <article style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; background:#fff;">
                <h2 style="margin:0; font-size:1.15rem; color:#111827;">Mapa público</h2>
                <p style="margin:0.55rem 0 1rem; color:#4b5563; line-height:1.6;">
                    Controla el acercamiento inicial y la intensidad visual de los nombres de calles.
                </p>
                <form action="{{ path('admin_system_settings_map') }}" method="POST" style="display:grid; gap:0.9rem;">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_map_settings') }}">
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Zoom inicial</span>
                        <input type="number" name="default_zoom" min="10" max="20" value="{{ map_settings.default_zoom }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Zoom al seleccionar ubicación/local</span>
                        <input type="number" name="focused_zoom" min="10" max="20" value="{{ map_settings.focused_zoom }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Tipografía de calles</span>
                        <select name="street_label_weight" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                            <option value="normal" {{ map_settings.street_label_weight == 'normal' ? 'selected' : '' }}>Normal</option>
                            <option value="light" {{ map_settings.street_label_weight == 'light' ? 'selected' : '' }}>Ligera</option>
                        </select>
                    </label>
                    <button type="submit" style="justify-self:start; display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border:none; border-radius:999px; padding:0.65rem 1rem; background:#111827; color:#fff; font-weight:700; cursor:pointer;">
                        Guardar mapa
                    </button>
                </form>
            </article>

            <article style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; background:#fff;">
                <h2 style="margin:0; font-size:1.15rem; color:#111827;">Google Places API</h2>
                <p style="margin:0.55rem 0 1rem; color:#4b5563; line-height:1.6;">
                    Ajusta cobertura, cantidad de resultados y caché del proxy sin rebasar el alpha.
                </p>
                <form action="{{ path('admin_system_settings_places') }}" method="POST" style="display:grid; gap:0.9rem;">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_places_settings') }}">
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Radio máximo para mostrar locales</span>
                        <input type="number" name="nearby_radius_meters" min="100" max="1000" value="{{ places_settings.nearby_radius_meters }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Resultados por Nearby Search por request</span>
                        <input type="number" name="nearby_max_results" min="1" max="20" value="{{ places_settings.nearby_max_results }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                        <small style="color:#6b7280;">Google limita Nearby Search a 20 resultados por request. Para ver más, usa máximo total y Text Search.</small>
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Resultados por Text Search</span>
                        <input type="number" name="text_search_page_size" min="1" max="20" value="{{ places_settings.text_search_page_size }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Modo de Text Search</span>
                        <select name="text_search_mode" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                            <option value="category_only" {{ places_settings.text_search_mode == 'category_only' ? 'selected' : '' }}>Solo cuando el usuario elige categoría</option>
                            <option value="always" {{ places_settings.text_search_mode == 'always' ? 'selected' : '' }}>Siempre, incluyendo Todos</option>
                            <option value="off" {{ places_settings.text_search_mode == 'off' ? 'selected' : '' }}>Apagado</option>
                        </select>
                        <small style="color:#6b7280;">Usa "Solo cuando el usuario elige categoría" para bajar requests en producción.</small>
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Máximo total a mostrar</span>
                        <input type="number" name="max_total_places" min="1" max="120" value="{{ places_settings.max_total_places }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">TTL de caché con resultados</span>
                        <input type="number" name="cache_ttl_seconds" min="60" max="900" value="{{ places_settings.cache_ttl_seconds }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">TTL de caché sin resultados</span>
                        <input type="number" name="empty_cache_ttl_seconds" min="30" max="300" value="{{ places_settings.empty_cache_ttl_seconds }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <fieldset style="display:grid; gap:0.65rem; margin:0.2rem 0 0; padding:0.9rem; border:1px solid #e5e7eb; border-radius:14px;">
                        <legend style="padding:0 0.35rem; font-weight:800; color:#111827;">Campos solicitados a Google</legend>
                        <label style="display:flex; align-items:flex-start; gap:0.55rem; color:#374151; line-height:1.45;">
                            <input type="checkbox" name="include_photos" value="1" {{ places_settings.include_photos ? 'checked' : '' }} style="margin-top:0.2rem;">
                            <span><strong>Fotos</strong><br><small>Solicita fotos para enriquecer cards.</small></span>
                        </label>
                        <label style="display:flex; align-items:flex-start; gap:0.55rem; color:#374151; line-height:1.45;">
                            <input type="checkbox" name="include_ratings" value="1" {{ places_settings.include_ratings ? 'checked' : '' }} style="margin-top:0.2rem;">
                            <span><strong>Ratings y reseñas</strong><br><small>Solicita rating y cantidad de reseñas.</small></span>
                        </label>
                        <label style="display:flex; align-items:flex-start; gap:0.55rem; color:#374151; line-height:1.45;">
                            <input type="checkbox" name="include_opening_hours" value="1" {{ places_settings.include_opening_hours ? 'checked' : '' }} style="margin-top:0.2rem;">
                            <span><strong>Horarios y disponibilidad</strong><br><small>Solicita horarios actuales/regulares para mostrar abierto o cerrado.</small></span>
                        </label>
                        <label style="display:flex; align-items:flex-start; gap:0.55rem; color:#374151; line-height:1.45;">
                            <input type="checkbox" name="include_service_attributes" value="1" {{ places_settings.include_service_attributes ? 'checked' : '' }} style="margin-top:0.2rem;">
                            <span><strong>Delivery, para llevar y comer ahí</strong><br><small>Solicita atributos de servicio; úsalo con cautela por costo.</small></span>
                        </label>
                    </fieldset>
                    <button type="submit" style="justify-self:start; display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border:none; border-radius:999px; padding:0.65rem 1rem; background:#111827; color:#fff; font-weight:700; cursor:pointer;">
                        Guardar Places
                    </button>
                </form>
            </article>

            <article style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; background:#fff;">
                <h2 style="margin:0; font-size:1.15rem; color:#111827;">Branding público</h2>
                <p style="margin:0.55rem 0 1rem; color:#4b5563; line-height:1.6;">
                    Identidad consumible por Public. Este bloque no pertenece al plugin de Places ni a configuración de mapa.
                </p>
                <form action="{{ path('admin_system_settings_public_branding') }}" method="POST" style="display:grid; gap:0.9rem;">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_public_branding') }}">
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Nombre de app</span>
                        <input type="text" name="app_name" maxlength="80" value="{{ public_branding.app_name }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Logo horizontal URL</span>
                        <input type="text" name="logo_horizontal_url" value="{{ public_branding.logo_horizontal_url }}" placeholder="/images/branding/logo-horizontal.png" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Logo cuadrado URL</span>
                        <input type="text" name="logo_square_url" value="{{ public_branding.logo_square_url }}" placeholder="/images/branding/logo-square.png" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Favicon URL</span>
                        <input type="text" name="favicon_url" value="{{ public_branding.favicon_url }}" placeholder="/favicon.ico" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Theme color</span>
                        <input type="text" name="theme_color" maxlength="7" value="{{ public_branding.theme_color }}" placeholder="#ff7a00" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Meta title default</span>
                        <input type="text" name="default_meta_title" maxlength="120" value="{{ public_branding.default_meta_title }}" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                    </label>
                    <label style="display:grid; gap:0.4rem;">
                        <span style="font-weight:700; color:#111827;">Meta description default</span>
                        <textarea name="default_meta_description" rows="3" maxlength="220" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">{{ public_branding.default_meta_description }}</textarea>
                    </label>
                    <button type="submit" style="justify-self:start; display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border:none; border-radius:999px; padding:0.65rem 1rem; background:#111827; color:#fff; font-weight:700; cursor:pointer;">
                        Guardar branding
                    </button>
                </form>
            </article>
        </section>
    </main>
{% endblock %}
