{% extends 'base.html.twig' %}

{% block title %}Analytics | Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width:1120px; margin:0 auto; padding:3rem 1.5rem; font-family:system-ui,sans-serif;">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Alpha Admin</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">Analytics</h1>
                <p style="margin:0.6rem 0 0; color:#4b5563;">Tendencias de los últimos rollups diarios persistidos.</p>
            </div>
            <a href="{{ path('admin_dashboard') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">Volver al dashboard</a>
        </div>

        <section style="display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:1rem; margin-top:1.5rem;">
            {% for event_name, total in totals|slice(0, 6) %}
                <article style="border:1px solid #e5e7eb; border-radius:16px; padding:1rem; background:#fff;">
                    <span style="display:block; color:#6b7280; font-size:0.78rem; word-break:break-word;">{{ event_name }}</span>
                    <strong style="display:block; margin-top:0.45rem; color:#111827; font-size:1.8rem;">{{ total }}</strong>
                </article>
            {% else %}
                <article style="border:1px solid #e5e7eb; border-radius:16px; padding:1rem; background:#fff;">
                    <strong style="color:#111827;">Sin rollups todavía</strong>
                    <p style="margin:0.45rem 0 0; color:#6b7280;">Ejecuta el comando diario para poblar tendencias.</p>
                </article>
            {% endfor %}
        </section>

        <section style="border:1px solid #e5e7eb; border-radius:18px; padding:1.15rem; margin-top:1.5rem; background:#fff; overflow:auto;">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
                <div>
                    <p style="margin:0; color:#6b7280; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.06em;">Tendencia diaria</p>
                    <h2 style="margin:0.4rem 0 0; color:#111827; font-size:1.2rem;">Eventos principales</h2>
                </div>
                <code style="background:#f8fafc; border:1px solid #e5e7eb; border-radius:12px; padding:0.55rem 0.7rem; color:#334155;">{{ cron_command }}</code>
            </div>
            <table style="width:100%; border-collapse:collapse; margin-top:1rem; min-width:760px;">
                <thead>
                    <tr style="text-align:left; color:#64748b; font-size:0.82rem;">
                        <th style="padding:0.65rem; border-bottom:1px solid #e5e7eb;">Fecha</th>
                        {% for event_name in top_events %}
                            <th style="padding:0.65rem; border-bottom:1px solid #e5e7eb;">{{ event_name }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for day in days %}
                        <tr>
                            <td style="padding:0.65rem; border-bottom:1px solid #f1f5f9; color:#111827; font-weight:700;">{{ day }}</td>
                            {% for event_name in top_events %}
                                <td style="padding:0.65rem; border-bottom:1px solid #f1f5f9; color:#334155;">{{ series[day][event_name]|default(0) }}</td>
                            {% endfor %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" style="padding:0.9rem; color:#64748b;">Aún no hay datos agregados.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
{% endblock %}
