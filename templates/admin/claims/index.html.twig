{% extends 'base.html.twig' %}

{% block title %}Claims | Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width: 1120px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif;">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div style="margin-bottom: 1rem; border-radius: 14px; padding: 0.9rem 1rem; background: {{ label == 'error' ? '#fff1f2' : '#eff6ff' }}; color: {{ label == 'error' ? '#be123c' : '#1d4ed8' }};">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Alpha Admin</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">Claims de locales</h1>
            </div>
            <a href="{{ path('admin_dashboard') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">Volver al dashboard</a>
        </div>
        <section style="margin-top:1.5rem; display:grid; gap:0.9rem;">
            {% if claims is empty %}
                <article style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; background:#fff;">
                    <strong>No hay claims todavía.</strong>
                </article>
            {% else %}
                {% for claim in claims %}
                    <article style="display:grid; gap:0.75rem; border:1px solid #e5e7eb; border-radius:18px; padding:1rem 1.1rem; background:#fff;">
                        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
                            <div>
                                <strong style="display:block; color:#111827;">{{ claim.locationName }}</strong>
                                <span style="display:block; margin-top:0.2rem; color:#6b7280;">{{ claim.shortAddress ?: 'Sin direccion' }}</span>
                            </div>
                            <span style="padding:0.32rem 0.65rem; border-radius:999px; background:#111827; color:#fff; font-size:0.76rem; font-weight:800; text-transform:uppercase;">{{ claim.statusLabel(claim.status) }}</span>
                        </div>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; color:#6b7280; font-size:0.92rem;">
                            <span>{{ claim.sourceType }}</span>
                            <span>{{ claim.claimantName }}</span>
                            <span>{{ claim.email }}</span>
                            {% if claim.externalSourceKey %}<span>{{ claim.externalSourceKey }}</span>{% endif %}
                        </div>
                        {% set checklist = claim.reviewChecklistJson|default({}) %}
                        <form method="post" action="{{ path('admin_claims_status', { id: claim.id }) }}" style="display:grid; gap:0.75rem;">
                            <input type="hidden" name="_token" value="{{ csrf_token('claim_status_' ~ claim.id) }}">
                            <label style="display:grid; gap:0.35rem; color:#374151; font-weight:700;">
                                Evidencias del claim
                                <textarea name="evidence_links" rows="3" placeholder="https://..." style="width:100%; border:1px solid #d1d5db; border-radius:12px; padding:0.75rem; font:inherit; color:#111827;">{% for item in claim.evidenceLinksJson|default([]) %}{{ item.url }}{% if not loop.last %}&#10;{% endif %}{% endfor %}</textarea>
                            </label>
                            <div style="display:flex; gap:0.8rem; flex-wrap:wrap; color:#374151; font-size:0.9rem;">
                                <label style="display:inline-flex; align-items:center; gap:0.4rem;">
                                    <input type="checkbox" name="check_contact_verified" value="1" {{ checklist.contact_verified|default(false) ? 'checked' : '' }}>
                                    Contacto verificado
                                </label>
                                <label style="display:inline-flex; align-items:center; gap:0.4rem;">
                                    <input type="checkbox" name="check_ownership_evidence" value="1" {{ checklist.ownership_evidence|default(false) ? 'checked' : '' }}>
                                    Evidencia de propiedad
                                </label>
                                <label style="display:inline-flex; align-items:center; gap:0.4rem;">
                                    <input type="checkbox" name="check_location_match" value="1" {{ checklist.location_match|default(false) ? 'checked' : '' }}>
                                    Coincide con el local
                                </label>
                            </div>
                            <label style="display:grid; gap:0.35rem; color:#374151; font-weight:700;">
                                Nota de revisión
                                <textarea name="review_notes" rows="2" placeholder="Notas internas para operación" style="width:100%; border:1px solid #d1d5db; border-radius:12px; padding:0.75rem; font:inherit; color:#111827;">{{ claim.reviewNotes }}</textarea>
                            </label>
                            <div style="display:flex; gap:0.65rem; flex-wrap:wrap;">
                                {% for status in statuses %}
                                    <button type="submit" name="status" value="{{ status }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.1rem; border-radius:999px; padding:0.5rem 0.9rem; border:1px solid #d1d5db; background:{{ claim.status == status ? '#111827' : '#fff' }}; color:{{ claim.status == status ? '#fff' : '#374151' }}; font-weight:700;">
                                        {{ claim.statusLabel(status) }}
                                    </button>
                                {% endfor %}
                            </div>
                        </form>
                    </article>
                {% endfor %}
            {% endif %}
        </section>
    </main>
{% endblock %}
