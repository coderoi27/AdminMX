{% extends 'base.html.twig' %}

{% block title %}Claims | Admin Mi Monchis MX{% endblock %}
{% block header_title %}Claims{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto space-y-6">
        <div class="flex items-end justify-between gap-4 flex-wrap">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.18em] text-orange-600">Revisión operativa</p>
                <h1 class="mt-1 text-3xl font-black text-slate-950">Claims de locales</h1>
                <p class="mt-2 text-sm text-slate-500">Revisa identidad y evidencia. Aprobar no crea ni publica un local.</p>
            </div>
            <span class="rounded-full bg-slate-950 px-4 py-2 text-sm font-black text-white">{{ claims|length }} resultados</span>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rounded-2xl border px-4 py-3 text-sm font-bold {{ label == 'error' ? 'border-rose-200 bg-rose-50 text-rose-800' : 'border-emerald-200 bg-emerald-50 text-emerald-800' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <form method="get" class="grid gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm md:grid-cols-5">
            <label class="grid gap-1.5 text-xs font-black uppercase tracking-wide text-slate-500">Estado
                <select name="status" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold normal-case text-slate-900">
                    <option value="">Todos</option>
                    {% for status in statuses %}<option value="{{ status }}" {{ filters.status == status ? 'selected' }}>{{ status }}</option>{% endfor %}
                </select>
            </label>
            <label class="grid gap-1.5 text-xs font-black uppercase tracking-wide text-slate-500">Fuente
                <select name="source" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold normal-case text-slate-900">
                    <option value="">Todas</option>
                    {% for source in sources %}<option value="{{ source }}" {{ filters.source == source ? 'selected' }}>{{ source }}</option>{% endfor %}
                </select>
            </label>
            <label class="grid gap-1.5 text-xs font-black uppercase tracking-wide text-slate-500">Desde
                <input type="date" name="date_from" value="{{ filters.date_from }}" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm text-slate-900">
            </label>
            <label class="grid gap-1.5 text-xs font-black uppercase tracking-wide text-slate-500">Hasta
                <input type="date" name="date_to" value="{{ filters.date_to }}" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm text-slate-900">
            </label>
            <div class="flex items-end gap-2">
                <button class="flex-1 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-black text-white">Filtrar</button>
                <a href="{{ path('admin_claims_index') }}" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600">Limpiar</a>
            </div>
        </form>

        <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
            {% if claims is empty %}
                <div class="p-10 text-center text-sm font-semibold text-slate-500">No hay claims para estos filtros.</div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-100 text-left text-sm">
                        <thead class="bg-slate-50 text-xs font-black uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-4">Local</th><th class="px-5 py-4">Solicitante</th><th class="px-5 py-4">Fuente</th><th class="px-5 py-4">Estado</th><th class="px-5 py-4">Fecha</th><th class="px-5 py-4"></th></tr></thead>
                        <tbody class="divide-y divide-slate-100">
                        {% for claim in claims %}
                            <tr class="hover:bg-orange-50/40">
                                <td class="px-5 py-4"><strong class="block text-slate-950">{{ claim.locationName ?: 'Local sin nombre' }}</strong><span class="mt-1 block max-w-xs truncate text-xs text-slate-500">{{ claim.shortAddress ?: 'Sin dirección' }}</span></td>
                                <td class="px-5 py-4"><span class="block font-semibold text-slate-800">{{ claim.claimantName ?: 'Sin nombre' }}</span><span class="text-xs text-slate-500">{{ claim.email ?: 'Sin correo' }}</span></td>
                                <td class="px-5 py-4 font-semibold text-slate-600">{{ claim.sourceType }}</td>
                                <td class="px-5 py-4"><span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-black text-slate-700">{{ claim.status }}</span></td>
                                <td class="px-5 py-4 text-slate-500">{{ claim.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="px-5 py-4 text-right"><a href="{{ path('admin_claims_show', {id: claim.id}) }}" class="rounded-xl bg-orange-600 px-3 py-2 text-xs font-black text-white">Revisar</a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
