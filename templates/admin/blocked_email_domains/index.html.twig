{% extends 'base.html.twig' %}

{% block title %}Blacklist de correos | Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width: 1120px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif;">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div style="margin-bottom: 1rem; border-radius: 14px; padding: 0.9rem 1rem; background: {{ label == 'error' ? '#fff1f2' : '#eff6ff' }}; color: {{ label == 'error' ? '#be123c' : '#1d4ed8' }};">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Alpha Admin</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">Blacklist de correos temporales</h1>
            </div>
            <a href="{{ path('admin_dashboard') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">Volver al dashboard</a>
        </div>
        <section style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; margin-top:1.5rem; background:#fff;">
            <form method="post" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:0.85rem; align-items:end;">
                <label style="display:grid; gap:0.4rem;">
                    <span>Dominio</span>
                    <input type="text" name="domain" placeholder="mailinator.com" style="border:1px solid #d1d5db; border-radius:12px; padding:0.8rem 0.9rem;">
                </label>
                <label style="display:grid; gap:0.4rem;">
                    <span>Proveedor</span>
                    <input type="text" name="provider_name" placeholder="Mailinator" style="border:1px solid #d1d5db; border-radius:12px; padding:0.8rem 0.9rem;">
                </label>
                <label style="display:grid; gap:0.4rem;">
                    <span>Motivo</span>
                    <input type="text" name="reason" placeholder="Correo temporal" style="border:1px solid #d1d5db; border-radius:12px; padding:0.8rem 0.9rem;">
                </label>
                <button type="submit" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.7rem; border:none; border-radius:999px; padding:0.7rem 1.15rem; background:#111827; color:#fff; font-weight:700;">Agregar dominio</button>
            </form>
        </section>
        <section style="margin-top:1.5rem; display:grid; gap:0.8rem;">
            {% for domain in domains %}
                <article style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; border:1px solid #e5e7eb; border-radius:18px; padding:1rem 1.1rem; background:#fff;">
                    <div>
                        <strong style="display:block;">{{ domain.domain }}</strong>
                        <span style="display:block; margin-top:0.2rem; color:#6b7280;">{{ domain.providerName ?: 'Sin proveedor' }}{% if domain.reason %} · {{ domain.reason }}{% endif %}</span>
                    </div>
                    <form method="post" action="{{ path('admin_blocked_email_domains_toggle', { id: domain.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_blocked_domain_' ~ domain.id) }}">
                        <button type="submit" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.1rem; border:none; border-radius:999px; padding:0.5rem 0.9rem; background:{{ domain.isActive ? '#111827' : '#f3f4f6' }}; color:{{ domain.isActive ? '#fff' : '#374151' }}; font-weight:700;">
                            {{ domain.isActive ? 'Activo' : 'Inactivo' }}
                        </button>
                    </form>
                </article>
            {% else %}
                <article style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; background:#fff;">
                    <strong>Todavía no hay dominios bloqueados.</strong>
                </article>
            {% endfor %}
        </section>
    </main>
{% endblock %}
