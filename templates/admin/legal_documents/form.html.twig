{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} | Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width: 920px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif;">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Centro legal</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">{{ page_title }}</h1>
                <p style="margin:0.55rem 0 0; color:#4b5563; line-height:1.6;">Edita el contenido que Public consume desde la API del core.</p>
            </div>
            <a href="{{ path('admin_legal_documents_index') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">Volver</a>
        </div>

        {% if errors is not empty %}
            <section style="margin-top:1.25rem; border-radius:16px; padding:1rem 1.1rem; background:#fff1f2; color:#be123c;">
                <strong style="display:block; margin-bottom:0.45rem;">Corrige lo siguiente:</strong>
                <ul style="margin:0; padding-left:1.1rem; line-height:1.7;">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <form method="post" style="display:grid; gap:1rem; margin-top:1.5rem;">
            <section style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; display:grid; gap:1rem; background:#fff;">
                <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem;">
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Título</span>
                        <input type="text" name="title" value="{{ document.title }}" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Slug</span>
                        <input type="text" name="slug" value="{{ document.slug }}" placeholder="aviso-privacidad" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Versión</span>
                        <input type="text" name="version_label" value="{{ document.versionLabel }}" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Estado</span>
                        <select name="status" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem; background:#fff;">
                            {% for status in statuses %}
                                <option value="{{ status }}" {{ document.status == status ? 'selected' }}>{{ status }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Orden</span>
                        <input type="number" name="sort_order" value="{{ document.sortOrder }}" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Vigente desde</span>
                        <input type="date" name="effective_at" value="{{ document.effectiveAt ? document.effectiveAt|date('Y-m-d') : '' }}" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                </div>
                <label style="display:inline-flex; align-items:center; gap:0.5rem; color:#374151; font-weight:700;">
                    <input type="checkbox" name="show_in_footer" value="1" {{ document.showInFooter ? 'checked' }}>
                    Mostrar en enlaces legales del footer
                </label>
                <label style="display:grid; gap:0.45rem;">
                    <span style="font-weight:700; color:#111827;">Resumen</span>
                    <textarea name="summary" rows="3" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem; resize:vertical;">{{ document.summary ?? '' }}</textarea>
                </label>
                <label style="display:grid; gap:0.45rem;">
                    <span style="font-weight:700; color:#111827;">Contenido</span>
                    <textarea name="body" rows="18" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem; resize:vertical; line-height:1.55;">{{ document.body }}</textarea>
                </label>
            </section>
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
                <button type="submit" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.7rem; border:none; border-radius:999px; padding:0.7rem 1.15rem; background:#111827; color:#fff; font-weight:700;">Guardar documento</button>
                <a href="{{ path('admin_legal_documents_index') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.7rem; border-radius:999px; padding:0.7rem 1.15rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">Cancelar</a>
            </div>
        </form>
    </main>
{% endblock %}
