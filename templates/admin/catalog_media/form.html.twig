{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Editar medio' : 'Agregar medio' }} | Admin Mi Monchis MX{% endblock %}
{% block header_title %}Biblioteca de medios{% endblock %}

{% block body %}
    <main style="max-width: 1080px; margin: 0 auto; padding: 2.5rem 1.5rem; font-family: system-ui, sans-serif;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Catálogo público</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">{{ is_edit ? 'Editar metadata' : 'Agregar medio' }}</h1>
                <p style="margin:0.6rem 0 0; color:#4b5563; line-height:1.6;">
                    El upload se realiza desde la Biblioteca. Esta pantalla conserva metadata, derechos, licencia y activación.
                </p>
            </div>
            <a href="{{ path('admin_catalog_media_index') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:800;">
                Volver a biblioteca
            </a>
        </div>

        {% if errors is not empty %}
            <section style="margin-top:1rem; border:1px solid #fecaca; border-radius:14px; padding:1rem; background:#fef2f2; color:#991b1b;">
                <strong>Revisa la metadata</strong>
                <ul style="margin:0.5rem 0 0; padding-left:1.2rem;">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <section style="margin-top:1.25rem; border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; background:#fff;">
            {% include 'admin/catalog_media/_form.html.twig' %}
        </section>
    </main>
{% endblock %}
