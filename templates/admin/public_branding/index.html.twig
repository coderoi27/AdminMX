{% extends 'base.html.twig' %}

{% block title %}Branding Público y Social Share | Admin Mi Monchis MX{% endblock %}
{% block header_title %}Branding Público y Social Share{% endblock %}

{% block body %}
    <div class="mx-auto max-w-[1500px] space-y-6">
        <header class="flex flex-wrap items-start justify-between gap-4">
            <div class="max-w-3xl">
                <p class="mb-2 text-xs font-black uppercase tracking-[0.18em] text-orange-600">Configuración global</p>
                <h1 class="m-0 text-3xl font-black tracking-tight text-slate-950">Branding Público y Social Share</h1>
                <p class="mt-3 text-base leading-7 text-slate-600">
                    Administra identidad, assets y metadata social desde un solo lugar. Public consume este contrato; no pertenece a mapa ni a Google Places.
                </p>
            </div>
            <a href="{{ path('admin_dashboard') }}" class="glass-btn">Volver al dashboard</a>
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rounded-2xl border px-4 py-3 font-semibold {{ label == 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-rose-200 bg-rose-50 text-rose-800' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(form, {
            attr: {
                enctype: 'multipart/form-data',
                class: 'grid gap-6 xl:grid-cols-[minmax(0,1fr)_420px]',
                'data-controller': 'branding-preview',
                'data-action': 'input->branding-preview#update change->branding-preview#update'
            }
        }) }}
            <div class="space-y-6">
                {% if not form.vars.valid %}
                    <section class="rounded-3xl border border-rose-200 bg-rose-50 p-5 text-rose-800">
                        <h2 class="m-0 text-base font-black">Revisa los campos marcados</h2>
                        <div class="mt-2 text-sm">{{ form_errors(form) }}</div>
                    </section>
                {% endif %}

                <section class="glass-card p-6 md:p-8">
                    <div class="mb-6 border-b border-white/60 pb-5">
                        <p class="m-0 text-xs font-black uppercase tracking-[0.14em] text-slate-400">01 · Base</p>
                        <h2 class="mt-2 text-xl font-black text-slate-950">Identidad y SEO general</h2>
                        <p class="mt-2 text-sm leading-6 text-slate-600">Estos valores son el fallback para todas las plataformas cuando no existe una personalización.</p>
                    </div>

                    <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_150px]">
                        <label class="grid gap-2">
                            <span class="text-sm font-bold text-slate-800">{{ form.app_name.vars.label }}</span>
                            {{ form_widget(form.app_name, {attr: {class: 'rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 outline-none focus:border-orange-400', maxlength: 80, 'data-branding-preview-target': 'appNameInput'}}) }}
                            <span class="text-xs text-slate-500">Nombre visible de la web app.</span>
                            {{ form_errors(form.app_name) }}
                        </label>
                        <label class="grid gap-2">
                            <span class="text-sm font-bold text-slate-800">{{ form.theme_color.vars.label }}</span>
                            {{ form_widget(form.theme_color, {attr: {class: 'h-12 w-full rounded-2xl border border-slate-200 bg-white p-1'}}) }}
                            <span class="text-xs text-slate-500">Usado en navegador/PWA.</span>
                            {{ form_errors(form.theme_color) }}
                        </label>
                        <label class="grid gap-2 md:col-span-2">
                            <span class="text-sm font-bold text-slate-800">{{ form.default_meta_title.vars.label }}</span>
                            {{ form_widget(form.default_meta_title, {attr: {class: 'rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 outline-none focus:border-orange-400', maxlength: 120, 'data-branding-preview-target': 'baseTitleInput'}}) }}
                            <span class="text-xs text-slate-500">Recomendado: 50–60 caracteres.</span>
                            {{ form_errors(form.default_meta_title) }}
                        </label>
                        <label class="grid gap-2 md:col-span-2">
                            <span class="text-sm font-bold text-slate-800">{{ form.default_meta_description.vars.label }}</span>
                            {{ form_widget(form.default_meta_description, {attr: {class: 'min-h-28 rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 outline-none focus:border-orange-400', maxlength: 220, 'data-branding-preview-target': 'baseDescriptionInput'}}) }}
                            <span class="text-xs text-slate-500">Recomendado: 140–160 caracteres.</span>
                            {{ form_errors(form.default_meta_description) }}
                        </label>
                    </div>
                </section>

                <section class="glass-card p-6 md:p-8">
                    <div class="mb-6 border-b border-white/60 pb-5">
                        <p class="m-0 text-xs font-black uppercase tracking-[0.14em] text-slate-400">02 · Archivos</p>
                        <h2 class="mt-2 text-xl font-black text-slate-950">Assets visuales</h2>
                        <p class="mt-2 text-sm leading-6 text-slate-600">Selecciona archivos desde tu equipo. Admin los almacena y reemplaza el asset anterior después de guardar correctamente.</p>
                    </div>

                    <div class="grid gap-5 lg:grid-cols-3">
                        {% set brand_assets = [
                            {field: form.logo_horizontal, slot: 'logo_horizontal', title: 'Logo horizontal', help: 'Cabeceras y metadata. Máx. 2 MB.', url: current_config.logo_horizontal_url, class: 'h-20 w-full'},
                            {field: form.logo_square, slot: 'logo_square', title: 'Logo cuadrado', help: 'Perfil, icono y fallback social. Máx. 2 MB.', url: current_config.logo_square_url, class: 'h-20 w-20'},
                            {field: form.favicon, slot: 'favicon', title: 'Favicon', help: 'ICO, PNG o SVG seguro. Máx. 2 MB.', url: current_config.favicon_url, class: 'h-12 w-12'}
                        ] %}
                        {% for asset in brand_assets %}
                            <article class="flex min-w-0 flex-col rounded-3xl border border-white/70 bg-white/60 p-4 shadow-sm">
                                <div class="flex min-h-24 items-center justify-center rounded-2xl bg-slate-100/80 p-3">
                                    {% if asset.url %}
                                        <img src="{{ asset.url }}" alt="{{ asset.title }} actual" class="{{ asset.class }} object-contain">
                                    {% else %}
                                        <span class="text-sm font-bold text-slate-400">Sin asset</span>
                                    {% endif %}
                                </div>
                                <h3 class="mb-0 mt-4 text-base font-black text-slate-900">{{ asset.title }}</h3>
                                <p class="mb-4 mt-1 min-h-10 text-xs leading-5 text-slate-500">{{ asset.help }}</p>
                                {{ form_widget(asset.field, {attr: {class: 'block w-full rounded-xl border border-slate-200 bg-white p-2 text-xs', 'data-action': 'change->branding-preview#previewFile'}}) }}
                                <div class="mt-2 text-xs text-rose-700">{{ form_errors(asset.field) }}</div>
                                {% set manifest = attribute(current_config.asset_manifest, asset.slot)|default(null) %}
                                {% if manifest %}
                                    <p class="mt-3 break-all text-[0.7rem] leading-4 text-slate-400">{{ manifest.mime_type }} · {{ (manifest.size_bytes / 1024)|round }} KB</p>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>
                </section>

                <section class="glass-card p-6 md:p-8">
                    <div class="mb-6 border-b border-white/60 pb-5">
                        <p class="m-0 text-xs font-black uppercase tracking-[0.14em] text-slate-400">03 · Distribución</p>
                        <h2 class="mt-2 text-xl font-black text-slate-950">Social Share</h2>
                        <p class="mt-2 text-sm leading-6 text-slate-600">Open Graph funciona como fallback. Completa una red solo cuando necesites copy o imagen específica.</p>
                    </div>

                    <div class="space-y-4">
                        <details open class="rounded-3xl border border-slate-200 bg-white/65 p-5">
                            <summary class="cursor-pointer font-black text-slate-900">Base · Open Graph</summary>
                            <div class="mt-5 grid gap-4 md:grid-cols-2">
                                <label class="grid gap-2">
                                    <span class="text-sm font-bold text-slate-700">{{ form.default_og_title.vars.label }}</span>
                                    {{ form_widget(form.default_og_title, {attr: {class: 'rounded-2xl border border-slate-200 bg-white px-4 py-3', maxlength: 120, 'data-branding-preview-target': 'ogTitleInput'}}) }}
                                    {{ form_errors(form.default_og_title) }}
                                </label>
                                <label class="grid gap-2 md:row-span-2">
                                    <span class="text-sm font-bold text-slate-700">Imagen Open Graph</span>
                                    {% if current_config.social_share.default_og_image %}<img src="{{ current_config.social_share.default_og_image }}" alt="Open Graph actual" class="h-32 w-full rounded-2xl bg-slate-100 object-cover">{% endif %}
                                    {{ form_widget(form.default_og_image, {attr: {class: 'block w-full rounded-xl border border-slate-200 bg-white p-2 text-xs', 'data-action': 'change->branding-preview#previewFile', 'data-image-preview-target': 'baseImagePreview'}}) }}
                                    {{ form_errors(form.default_og_image) }}
                                </label>
                                <label class="grid gap-2">
                                    <span class="text-sm font-bold text-slate-700">{{ form.default_og_description.vars.label }}</span>
                                    {{ form_widget(form.default_og_description, {attr: {class: 'min-h-24 rounded-2xl border border-slate-200 bg-white px-4 py-3', maxlength: 220, 'data-branding-preview-target': 'ogDescriptionInput'}}) }}
                                    {{ form_errors(form.default_og_description) }}
                                </label>
                            </div>
                        </details>

                        {% set networks = [
                            {name: 'Facebook', title: form.facebook_title, description: form.facebook_description, image: form.facebook_image, title_target: 'facebookTitleInput', description_target: 'facebookDescriptionInput', image_target: 'facebookImagePreview', current_image: current_config.social_share.facebook_image},
                            {name: 'X / Twitter', title: form.twitter_title, description: form.twitter_description, image: form.twitter_image, title_target: 'twitterTitleInput', description_target: 'twitterDescriptionInput', image_target: 'twitterImagePreview', current_image: current_config.social_share.twitter_image},
                            {name: 'Threads', title: form.threads_title, description: form.threads_description, image: form.threads_image, title_target: 'threadsTitleInput', description_target: 'threadsDescriptionInput', image_target: 'threadsImagePreview', current_image: current_config.social_share.threads_image},
                            {name: 'Google', title: form.google_title, description: form.google_description, image: form.google_image, title_target: 'googleTitleInput', description_target: 'googleDescriptionInput', image_target: 'googleImagePreview', current_image: current_config.social_share.google_image}
                        ] %}

                        {% for network in networks %}
                            <details class="rounded-3xl border border-slate-200 bg-white/65 p-5">
                                <summary class="cursor-pointer font-black text-slate-900">{{ network.name }} <span class="ml-2 text-xs font-medium text-slate-400">opcional · hereda Open Graph</span></summary>
                                <div class="mt-5 grid gap-4 md:grid-cols-2">
                                    {% if network.name == 'X / Twitter' %}
                                        <label class="grid gap-2 md:col-span-2">
                                            <span class="text-sm font-bold text-slate-700">{{ form.twitter_card_type.vars.label }}</span>
                                            {{ form_widget(form.twitter_card_type, {attr: {class: 'rounded-2xl border border-slate-200 bg-white px-4 py-3'}}) }}
                                        </label>
                                    {% endif %}
                                    <label class="grid gap-2">
                                        <span class="text-sm font-bold text-slate-700">{{ network.title.vars.label }}</span>
                                        {{ form_widget(network.title, {attr: {class: 'rounded-2xl border border-slate-200 bg-white px-4 py-3', maxlength: 120, 'data-branding-preview-target': network.title_target}}) }}
                                        {{ form_errors(network.title) }}
                                    </label>
                                    <label class="grid gap-2 md:row-span-2">
                                        <span class="text-sm font-bold text-slate-700">Imagen {{ network.name }}</span>
                                        {% if network.current_image %}<img src="{{ network.current_image }}" alt="{{ network.name }} actual" class="h-32 w-full rounded-2xl bg-slate-100 object-cover">{% endif %}
                                        {{ form_widget(network.image, {attr: {class: 'block w-full rounded-xl border border-slate-200 bg-white p-2 text-xs', 'data-action': 'change->branding-preview#previewFile', 'data-image-preview-target': network.image_target}}) }}
                                        {{ form_errors(network.image) }}
                                    </label>
                                    <label class="grid gap-2">
                                        <span class="text-sm font-bold text-slate-700">{{ network.description.vars.label }}</span>
                                        {{ form_widget(network.description, {attr: {class: 'min-h-24 rounded-2xl border border-slate-200 bg-white px-4 py-3', maxlength: 220, 'data-branding-preview-target': network.description_target}}) }}
                                        {{ form_errors(network.description) }}
                                    </label>
                                </div>
                            </details>
                        {% endfor %}
                    </div>
                </section>

                <div class="sticky bottom-4 z-10 flex flex-wrap items-center justify-between gap-3 rounded-3xl border border-white/70 bg-white/80 p-4 shadow-2xl backdrop-blur-xl">
                    <p class="m-0 text-sm text-slate-600">Los nuevos archivos sustituyen el slot actual después de persistir correctamente.</p>
                    <button type="submit" class="glass-btn-primary min-h-12 px-6">Guardar branding y assets</button>
                </div>
            </div>

            <aside class="space-y-4 xl:sticky xl:top-24 xl:self-start">
                <div class="glass-card p-5">
                    <p class="m-0 text-xs font-black uppercase tracking-[0.14em] text-slate-400">Preview en vivo</p>
                    <h2 class="mt-2 text-lg font-black text-slate-950">Cómo se compartirá</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Vista aproximada. Cada plataforma puede recortar texto e imagen de forma distinta.</p>
                </div>

                <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
                    <img src="{{ previews.open_graph.image }}" alt="Preview base" class="h-44 w-full bg-slate-100 object-cover" data-branding-preview-target="baseImagePreview" {{ previews.open_graph.image ? '' : 'hidden' }}>
                    <div class="p-4">
                        <span class="text-[0.68rem] font-black uppercase tracking-widest text-slate-400">Resultado base · Open Graph</span>
                        <h3 class="mb-0 mt-2 text-lg font-black leading-tight text-slate-950" data-branding-preview-target="baseTitlePreview">{{ previews.open_graph.title }}</h3>
                        <p class="mb-0 mt-2 line-clamp-2 text-sm leading-5 text-slate-600" data-branding-preview-target="baseDescriptionPreview">{{ previews.open_graph.description }}</p>
                    </div>
                </article>

                <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lg">
                    <img src="{{ previews.facebook.image }}" alt="Preview Facebook" class="h-36 w-full bg-slate-100 object-cover" data-branding-preview-target="facebookImagePreview" {{ previews.facebook.image ? '' : 'hidden' }}>
                    <div class="border-t border-slate-100 bg-slate-50 p-4">
                        <span class="text-[0.68rem] font-bold uppercase tracking-wider text-slate-500">mimonchis.mx · Facebook</span>
                        <h3 class="mb-0 mt-1 text-base font-bold text-slate-950" data-branding-preview-target="facebookTitlePreview">{{ previews.facebook.title }}</h3>
                        <p class="mb-0 mt-1 line-clamp-2 text-xs leading-5 text-slate-600" data-branding-preview-target="facebookDescriptionPreview">{{ previews.facebook.description }}</p>
                    </div>
                </article>

                <article class="overflow-hidden rounded-3xl border border-slate-300 bg-black text-white shadow-lg">
                    <img src="{{ previews.x_twitter.image }}" alt="Preview X" class="h-36 w-full bg-slate-900 object-cover" data-branding-preview-target="twitterImagePreview" {{ previews.x_twitter.image ? '' : 'hidden' }}>
                    <div class="p-4">
                        <span class="text-[0.68rem] font-bold text-slate-400">X / Twitter · mimonchis.mx</span>
                        <h3 class="mb-0 mt-1 text-base font-bold" data-branding-preview-target="twitterTitlePreview">{{ previews.x_twitter.title }}</h3>
                        <p class="mb-0 mt-1 line-clamp-2 text-xs leading-5 text-slate-300" data-branding-preview-target="twitterDescriptionPreview">{{ previews.x_twitter.description }}</p>
                    </div>
                </article>

                <article class="rounded-3xl border border-slate-200 bg-white p-4 shadow-lg">
                    <div class="flex gap-3">
                        <img src="{{ current_config.logo_square_url }}" alt="Avatar Threads" class="h-10 w-10 rounded-full bg-slate-100 object-contain">
                        <div class="min-w-0 flex-1">
                            <span class="text-xs font-black text-slate-950">{{ current_config.app_name }}</span>
                            <h3 class="mb-0 mt-2 text-sm font-bold text-slate-950" data-branding-preview-target="threadsTitlePreview">{{ previews.threads.title }}</h3>
                            <p class="mb-0 mt-1 line-clamp-2 text-xs leading-5 text-slate-600" data-branding-preview-target="threadsDescriptionPreview">{{ previews.threads.description }}</p>
                            <img src="{{ previews.threads.image }}" alt="Preview Threads" class="mt-3 h-32 w-full rounded-2xl bg-slate-100 object-cover" data-branding-preview-target="threadsImagePreview" {{ previews.threads.image ? '' : 'hidden' }}>
                        </div>
                    </div>
                </article>

                <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-lg">
                    <span class="text-sm text-emerald-700">https://mimonchis.mx</span>
                    <h3 class="mb-0 mt-1 text-xl font-medium text-blue-700" data-branding-preview-target="googleTitlePreview">{{ previews.google.title }}</h3>
                    <p class="mb-0 mt-1 line-clamp-2 text-sm leading-5 text-slate-600" data-branding-preview-target="googleDescriptionPreview">{{ previews.google.description }}</p>
                    <img src="{{ previews.google.image }}" alt="Preview Google" class="mt-3 h-24 w-full rounded-xl bg-slate-100 object-cover" data-branding-preview-target="googleImagePreview" {{ previews.google.image ? '' : 'hidden' }}>
                </article>
            </aside>
        {{ form_end(form) }}
    </div>
{% endblock %}
