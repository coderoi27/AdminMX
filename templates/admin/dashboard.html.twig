{% extends 'base.html.twig' %}

{% block title %}Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width: 960px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif;">
        <p style="margin: 0 0 0.5rem; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280;">
            Alpha Admin
        </p>
        <h1 style="margin: 0 0 1rem; font-size: 2rem;">Base operativa inicial</h1>
        <p style="margin: 0 0 2rem; color: #4b5563; line-height: 1.6;">
            Este proyecto ya aloja el runtime inicial del contexto <strong>core/domain</strong> y de la consola administrativa.
        </p>

        <section style="border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.25rem;">
            <h2 style="margin-top: 0;">Primer corte montado</h2>
            <ul style="line-height: 1.8; color: #374151;">
                <li>Estructura inicial de entidades Doctrine para core y admin</li>
                <li>Feed API base en <code>/api/v1/locations/feed</code></li>
                <li>Punto de partida para migraciones, leads, invitaciones y narrativa</li>
            </ul>
        </section>

        <section style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; margin-top:1.5rem;">
            <article style="border:1px solid #e5e7eb; border-radius:16px; padding:1rem 1.1rem; background:#fff;">
                <p style="margin:0; color:#6b7280; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.06em;">Correos capturados</p>
                <strong style="display:block; margin-top:0.35rem; font-size:2rem; color:#111827;">{{ stats.public_invitation_total }}</strong>
            </article>
            <article style="border:1px solid #e5e7eb; border-radius:16px; padding:1rem 1.1rem; background:#fff;">
                <p style="margin:0; color:#6b7280; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.06em;">Invitaciones enviadas</p>
                <strong style="display:block; margin-top:0.35rem; font-size:2rem; color:#111827;">{{ stats.public_invitation_sent }}</strong>
            </article>
            <article style="border:1px solid #e5e7eb; border-radius:16px; padding:1rem 1.1rem; background:#fff;">
                <p style="margin:0; color:#6b7280; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.06em;">Accesos usados</p>
                <strong style="display:block; margin-top:0.35rem; font-size:2rem; color:#111827;">{{ stats.public_invitation_used }}</strong>
            </article>
        </section>

        <section style="border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.25rem; margin-top: 1.5rem;">
            <h2 style="margin-top: 0;">Últimos correos alpha</h2>
            {% if stats.latest_public_invitations is empty %}
                <p style="margin: 0; color:#6b7280;">Todavía no hay solicitudes registradas.</p>
            {% else %}
                <div style="display:grid; gap:0.75rem;">
                    {% for invitation in stats.latest_public_invitations %}
                        <article style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:0.85rem 0.95rem; border-radius:14px; background:#f8fafc;">
                            <div>
                                <strong style="display:block; color:#111827;">{{ invitation.email }}</strong>
                                <span style="color:#6b7280; font-size:0.9rem;">{{ invitation.createdAt|date('Y-m-d H:i') }}</span>
                            </div>
                            <span style="padding:0.32rem 0.6rem; border-radius:999px; background:#fff; border:1px solid #e5e7eb; color:#374151; font-size:0.78rem; font-weight:700; text-transform:uppercase;">{{ invitation.status }}</span>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
