{% extends 'base.html.twig' %}

{% block title %}Admin Mi Monchis MX{% endblock %}
{% block header_title %}Dashboard Operativo{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto space-y-8">
        
        <!-- Header Section -->
        <div class="space-y-2">
            <p class="text-sm font-bold tracking-widest text-gray-500 uppercase">Alpha Admin</p>
            <h1 class="text-4xl font-extrabold tracking-tight text-gray-900">Base operativa inicial</h1>
            <p class="text-lg text-gray-600 max-w-3xl">
                Este proyecto aloja el runtime inicial del contexto <strong class="font-semibold text-gray-900">core/domain</strong> y de la consola administrativa.
            </p>
        </div>

        <!-- Highlight Card -->
        <section class="glass-card p-8">
            <h2 class="text-xl font-bold mb-4 text-gray-800">Primer corte montado</h2>
            <ul class="space-y-2 text-gray-700 list-disc list-inside">
                <li>Estructura inicial de entidades Doctrine para core y admin</li>
                <li>Feed API base en <code class="bg-black/5 px-1.5 py-0.5 rounded text-sm">/api/v1/locations/feed</code></li>
                <li>Punto de partida para migraciones, leads, invitaciones y narrativa</li>
            </ul>
        </section>

        <!-- Stats Grid -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
            <article class="glass-card p-5 flex flex-col justify-between">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Correos capturados</p>
                <strong class="text-4xl font-black text-gray-900">{{ stats.public_invitation_total }}</strong>
            </article>
            <article class="glass-card p-5 flex flex-col justify-between">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Invitaciones enviadas</p>
                <strong class="text-4xl font-black text-gray-900">{{ stats.public_invitation_sent }}</strong>
            </article>
            <article class="glass-card p-5 flex flex-col justify-between">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Accesos usados</p>
                <strong class="text-4xl font-black text-gray-900">{{ stats.public_invitation_used }}</strong>
            </article>
            <article class="glass-card p-5 flex flex-col justify-between">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Locales canónicos</p>
                <strong class="text-4xl font-black text-gray-900">{{ stats.location_total }}</strong>
            </article>
            <article class="glass-card p-5 flex flex-col justify-between">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Categorías activas</p>
                <strong class="text-4xl font-black text-gray-900">{{ stats.active_category_total }}</strong>
            </article>
            <article class="glass-card p-5 flex flex-col justify-between">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Claims abiertos</p>
                <strong class="text-4xl font-black text-gray-900">{{ stats.claims_open_total }}</strong>
            </article>
        </section>

        <!-- Action Cards Grid -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <article class="glass-card p-6 flex flex-col h-full">
                <div class="flex-1">
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Configuración global</p>
                    <h2 class="text-2xl font-bold text-gray-900 mb-3">Sistema, mapa y plugins</h2>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        Ajusta comportamiento del mapa público y parámetros operativos de Google Places API.
                    </p>
                </div>
                <div class="flex flex-wrap gap-3 mt-auto">
                    <a href="{{ path('admin_system_settings_index') }}" class="glass-btn-primary">
                        Abrir configuraciones
                    </a>
                    <a href="{{ path('admin_public_branding_index') }}" class="glass-btn">
                        Branding y SEO
                    </a>
                </div>
            </article>

            <article class="glass-card p-6 flex flex-col h-full">
                <div class="flex-1">
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Acceso visible</p>
                    <h2 class="text-2xl font-bold text-gray-900 mb-3">Operar locales canónicos</h2>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        Alta, edición y archivado de locales reales, demo o Google desde el mismo circuito canónico.
                    </p>
                </div>
                <div class="flex flex-wrap gap-3 mt-auto">
                    <a href="{{ path('admin_locations_new') }}" class="glass-btn-primary">
                        Crear local
                    </a>
                    <a href="{{ path('admin_locations_index') }}" class="glass-btn">
                        Abrir listado
                    </a>
                </div>
            </article>

            <article class="glass-card p-6 flex flex-col h-full">
                <div class="flex-1">
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Fuente de verdad visual</p>
                    <h2 class="text-2xl font-bold text-gray-900 mb-3">Catálogo de categorías</h2>
                    <p class="text-gray-600 mb-4 leading-relaxed">
                        Administra categorías reales para chips, cards, pines y tandas demo sin depender de defaults.
                    </p>
                    <div class="mb-6">
                        <span class="inline-flex items-center px-3 py-1 rounded-full bg-orange-100/80 text-orange-800 text-xs font-bold border border-orange-200 backdrop-blur-sm">
                            {{ stats.category_total }} categorías totales
                        </span>
                    </div>
                </div>
                <div class="flex flex-wrap gap-3 mt-auto">
                    <a href="{{ path('admin_categories_new') }}" class="glass-btn-primary">
                        Crear categoría
                    </a>
                    <a href="{{ path('admin_categories_index') }}" class="glass-btn">
                        Abrir catálogo
                    </a>
                </div>
            </article>

        </section>
    </div>
{% endblock %}
