{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} | Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width: 820px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif;">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Plugin demo</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">{{ page_title }}</h1>
                <p style="margin:0.6rem 0 0; color:#4b5563; line-height:1.6;">
                    Define el contexto territorial y el subconjunto de categorías válidas que el plugin podrá sembrar en esta tanda.
                </p>
            </div>
            <a href="{{ path('admin_demo_batches_index') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">
                Volver al panel demo
            </a>
        </div>

        {% if errors is not empty %}
            <section style="margin-top:1.25rem; border-radius:16px; padding:1rem 1.1rem; background:#fff1f2; color:#be123c;">
                <strong style="display:block; margin-bottom:0.45rem;">Corrige lo siguiente:</strong>
                <ul style="margin:0; padding-left:1.1rem; line-height:1.7;">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <form method="post" style="display:grid; gap:1.5rem; margin-top:1.5rem;">
            <section style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; display:grid; gap:1rem; background:#fff;">
                <h2 style="margin:0;">Contexto de siembra</h2>
                <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem;">
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Nombre de la tanda</span>
                        <input type="text" name="name" value="{{ batch.name ?? '' }}" placeholder="Tanda demo Villahermosa" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">País</span>
                        <input type="text" name="country_code" value="{{ batch.countryCode ?? 'MX' }}" maxlength="2" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Estado</span>
                        <input type="text" name="state" value="{{ batch.state ?? '' }}" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Ciudad</span>
                        <input type="text" name="city" value="{{ batch.city ?? '' }}" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Zona o narrativa</span>
                        <input type="text" name="region_label" value="{{ batch.regionLabel ?? '' }}" placeholder="Centro histórico" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Latitud centro</span>
                        <input type="text" name="center_latitude" value="{{ batch.centerLatitude ?? '' }}" placeholder="19.4326080" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Longitud centro</span>
                        <input type="text" name="center_longitude" value="{{ batch.centerLongitude ?? '' }}" placeholder="-99.1332090" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Radio (m)</span>
                        <input type="number" name="radius_meters" value="{{ batch.radiusMeters ?? 1500 }}" min="100" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Cantidad solicitada</span>
                        <input type="number" name="requested_locations_count" value="{{ batch.requestedLocationsCount ?? 0 }}" min="0" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                    <label style="display:grid; gap:0.45rem;">
                        <span style="font-weight:700; color:#111827;">Expira en</span>
                        <input type="datetime-local" name="expires_at" value="{{ batch.expiresAt ? batch.expiresAt|date('Y-m-d\\TH:i') : '' }}" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem;">
                    </label>
                </div>
                <label style="display:grid; gap:0.45rem;">
                    <span style="font-weight:700; color:#111827;">Dirección fuente</span>
                    <textarea name="source_address" rows="3" style="border:1px solid #d1d5db; border-radius:14px; padding:0.85rem 0.9rem; resize:vertical;">{{ batch.sourceAddress ?? '' }}</textarea>
                </label>
            </section>

            <section style="border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; display:grid; gap:1rem; background:#fff;">
                <h2 style="margin:0;">Categorías válidas para esta tanda</h2>
                {% if categories is empty %}
                    <p style="margin:0; color:#6b7280;">Primero crea categorías activas en Admin para poder configurar el plugin demo.</p>
                {% else %}
                    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:0.85rem;">
                        {% for category in categories %}
                            <label style="display:flex; align-items:flex-start; gap:0.75rem; padding:0.85rem 0.9rem; border:1px solid #e5e7eb; border-radius:16px;">
                                <input type="checkbox" name="category_slugs[]" value="{{ category.slug }}" {{ category.slug in batch.categorySlugs ? 'checked' }}>
                                <span>
                                    <strong style="display:block; color:#111827;">{{ category.name }}</strong>
                                    <span style="display:flex; align-items:center; gap:0.45rem; margin-top:0.2rem; color:#6b7280;">
                                        <span style="display:inline-flex; width:0.72rem; height:0.72rem; border-radius:999px; background:{{ category.colorHex ?: '#CBD5E1' }};"></span>
                                        {{ category.slug }}
                                    </span>
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
                <button type="submit" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.7rem; border:none; border-radius:999px; padding:0.7rem 1.15rem; background:#111827; color:#fff; font-weight:700;">
                    Crear tanda
                </button>
                <a href="{{ path('admin_demo_batches_index') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.7rem; border-radius:999px; padding:0.7rem 1.15rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">
                    Cancelar
                </a>
            </div>
        </form>
    </main>
{% endblock %}
