{% extends 'base.html.twig' %}

{% block title %}Reglas de Places | Admin Mi Monchis MX{% endblock %}

{% block body %}
    <main style="max-width: 1040px; margin: 0 auto; padding: 3rem 1.5rem; font-family: system-ui, sans-serif;">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
                <p style="margin:0 0 0.4rem; font-size:0.82rem; letter-spacing:0.08em; text-transform:uppercase; color:#6b7280;">Google Places</p>
                <h1 style="margin:0; font-size:2rem; color:#111827;">Reglas de categorización</h1>
                <p style="margin:0.6rem 0 0; color:#4b5563; line-height:1.6;">
                    Traduce tipos y palabras del nombre de Places hacia categorías canónicas sin mezclar estas reglas con la definición visual.
                </p>
            </div>
            <a href="{{ path('admin_dashboard') }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.5rem; border-radius:999px; padding:0.6rem 1rem; border:1px solid #d1d5db; color:#374151; text-decoration:none; font-weight:700;">
                Volver al admin
            </a>
        </div>

        <section style="margin-top:1.5rem; border:1px solid #e5e7eb; border-radius:18px; padding:1.25rem; background:#fff;">
            <h2 style="margin:0 0 1rem; font-size:1.1rem; color:#111827;">Nueva regla</h2>
            <form action="{{ path('admin_place_category_rules_new') }}" method="POST" data-place-rule-form style="display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:1rem; align-items:end;">
                <input type="hidden" name="_token" value="{{ csrf_token('create_place_category_rule') }}">
                <label style="display:grid; gap:0.45rem;">
                    <span style="font-weight:700; color:#111827;">Categoría</span>
                    <select name="category_id" required style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label style="display:grid; gap:0.45rem;">
                    <span style="font-weight:700; color:#111827;">Tipo</span>
                    <select name="rule_type" required data-place-rule-type style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                        {% for rule_type in rule_types %}
                            <option value="{{ rule_type }}">{{ rule_type }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label style="display:grid; gap:0.45rem;">
                    <span style="font-weight:700; color:#111827;">Valor</span>
                    <select data-place-google-type-select style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                        {% for google_place_type in google_place_types %}
                            <option value="{{ google_place_type }}">{{ google_place_type }}</option>
                        {% endfor %}
                    </select>
                    <input type="text" name="match_value" required data-place-rule-match-value placeholder="taqueria o tacos" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                </label>
                <label style="display:grid; gap:0.45rem;">
                    <span style="font-weight:700; color:#111827;">Prioridad</span>
                    <input type="number" name="priority" value="100" style="border:1px solid #d1d5db; border-radius:12px; padding:0.75rem 0.8rem;">
                </label>
                <label style="display:flex; align-items:center; gap:0.5rem; color:#374151; font-weight:700; min-height:2.7rem;">
                    <input type="checkbox" name="is_active" value="1" checked>
                    Activa
                </label>
                <button type="submit" style="display:inline-flex; align-items:center; justify-content:center; min-height:2.7rem; border:none; border-radius:999px; padding:0.7rem 1.15rem; background:#111827; color:#fff; font-weight:700;">
                    Crear regla
                </button>
            </form>
        </section>

        <section style="margin-top:1.5rem; border:1px solid #e5e7eb; border-radius:18px; background:#fff; overflow:hidden;">
            <table style="width:100%; border-collapse:collapse; text-align:left;">
                <thead style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                    <tr>
                        <th style="padding:1rem; font-size:0.8rem; color:#64748b; text-transform:uppercase;">Prioridad</th>
                        <th style="padding:1rem; font-size:0.8rem; color:#64748b; text-transform:uppercase;">Tipo</th>
                        <th style="padding:1rem; font-size:0.8rem; color:#64748b; text-transform:uppercase;">Valor</th>
                        <th style="padding:1rem; font-size:0.8rem; color:#64748b; text-transform:uppercase;">Categoría</th>
                        <th style="padding:1rem; font-size:0.8rem; color:#64748b; text-transform:uppercase;">Estado</th>
                        <th style="padding:1rem; font-size:0.8rem; color:#64748b; text-transform:uppercase; text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rule in rules %}
                        <tr style="border-bottom:1px solid #f1f5f9;">
                            <td style="padding:1rem; color:#334155;">{{ rule.priority }}</td>
                            <td style="padding:1rem; font-family:monospace; color:#334155;">{{ rule.ruleType }}</td>
                            <td style="padding:1rem; font-family:monospace; color:#334155;">{{ rule.matchValue }}</td>
                            <td style="padding:1rem; color:#111827; font-weight:700;">{{ rule.category.name }}</td>
                            <td style="padding:1rem;">
                                <span style="display:inline-flex; border-radius:999px; padding:0.28rem 0.6rem; background:{{ rule.isActive ? '#dcfce7' : '#f3f4f6' }}; color:{{ rule.isActive ? '#166534' : '#4b5563' }}; font-size:0.78rem; font-weight:800;">
                                    {{ rule.isActive ? 'Activa' : 'Inactiva' }}
                                </span>
                            </td>
                            <td style="padding:1rem;">
                                <div style="display:flex; justify-content:flex-end; gap:0.6rem; flex-wrap:wrap;">
                                    <form action="{{ path('admin_place_category_rules_toggle', {id: rule.id}) }}" method="POST" style="margin:0;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_place_category_rule_' ~ rule.id) }}">
                                        <button type="submit" style="border:1px solid #d1d5db; background:#fff; color:#374151; border-radius:999px; padding:0.45rem 0.75rem; font-weight:700; cursor:pointer;">
                                            {{ rule.isActive ? 'Desactivar' : 'Activar' }}
                                        </button>
                                    </form>
                                    <form action="{{ path('admin_place_category_rules_delete', {id: rule.id}) }}" method="POST" onsubmit="return confirm('¿Eliminar esta regla?');" style="margin:0;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_place_category_rule_' ~ rule.id) }}">
                                        <button type="submit" style="border:1px solid #fecaca; background:#fff; color:#b91c1c; border-radius:999px; padding:0.45rem 0.75rem; font-weight:700; cursor:pointer;">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="padding:2rem; text-align:center; color:#94a3b8;">Aún no hay reglas de Places.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
    <script>
        (() => {
            const form = document.querySelector('[data-place-rule-form]');
            if (!form) {
                return;
            }

            const ruleType = form.querySelector('[data-place-rule-type]');
            const matchValue = form.querySelector('[data-place-rule-match-value]');
            const googleTypeSelect = form.querySelector('[data-place-google-type-select]');

            const syncRuleValueControl = () => {
                const usesGoogleType = ruleType.value === 'google_type';
                googleTypeSelect.hidden = !usesGoogleType;
                matchValue.hidden = usesGoogleType;
                matchValue.value = usesGoogleType ? googleTypeSelect.value : matchValue.value;
                matchValue.placeholder = usesGoogleType ? 'Selecciona un tipo de Google Places' : 'taqueria o tacos';
            };

            ruleType.addEventListener('change', syncRuleValueControl);
            googleTypeSelect.addEventListener('change', syncRuleValueControl);
            syncRuleValueControl();
        })();
    </script>
{% endblock %}
