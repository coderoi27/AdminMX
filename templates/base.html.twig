<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="antialiased text-gray-800">
        <!-- Sidebar -->
        {% if app.user %}
        {% set current_route = app.request.attributes.get('_route') ?? '' %}
        <aside class="fixed top-0 left-0 h-screen w-64 glass-panel border-r border-white/40 z-20 flex flex-col">
            <div class="h-16 flex items-center px-6 border-b border-white/20">
                <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Mi Monchis</span>
                <span class="ml-2 text-sm font-semibold text-gray-500 uppercase">Admin</span>
            </div>
            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                <a href="{{ path('admin_dashboard') }}" class="block px-3 py-2.5 rounded-xl hover:bg-white/50 transition-colors font-medium text-gray-700">Dashboard</a>
                <a href="{{ path('admin_locations_index') }}" class="block px-3 py-2.5 rounded-xl hover:bg-white/50 transition-colors font-medium text-gray-700">Locales</a>
                <a href="{{ path('admin_categories_index') }}" class="block px-3 py-2.5 rounded-xl hover:bg-white/50 transition-colors font-medium text-gray-700">Categorías</a>
                <a href="{{ path('admin_catalog_media_index') }}" class="block px-3 py-2.5 rounded-xl hover:bg-white/50 transition-colors font-medium {{ current_route starts with 'admin_catalog_media_' ? 'bg-white/70 text-gray-950' : 'text-gray-700' }}">Biblioteca de medios</a>
                <div class="pt-4 mt-4 border-t border-white/20">
                    <p class="px-3 text-[0.7rem] font-bold text-gray-400 uppercase tracking-wider mb-2">Configuración global</p>
                    <a href="{{ path('admin_system_settings_index') }}" class="block px-3 py-2.5 rounded-xl hover:bg-white/50 transition-colors font-medium text-gray-700">Sistema y Mapa</a>
                    <a href="{{ path('admin_public_branding_index') }}" class="block px-3 py-2.5 rounded-xl hover:bg-white/50 transition-colors font-medium text-gray-700">Branding y SEO</a>
                </div>
            </nav>
        </aside>
        {% endif %}

        <!-- Main Content -->
        <div class="{% if app.user %}pl-64{% endif %} flex flex-col min-h-screen">
            {% if app.user %}
            <header class="h-16 glass-panel border-b border-white/40 sticky top-0 z-10 flex items-center px-8 justify-between">
                <h2 class="text-xl font-bold text-gray-800 tracking-tight">{% block header_title %}Panel de Control{% endblock %}</h2>
                <div class="flex items-center gap-4">
                    <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-blue-500 to-purple-500 shadow-inner flex items-center justify-center text-white font-bold text-sm">
                        A
                    </div>
                </div>
            </header>
            {% endif %}
            
            <main class="flex-1 {% if app.user %}p-8{% endif %}">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
