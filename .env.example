APP_ENV=dev
APP_SECRET=change-me

# Local MySQL example. Keep real credentials in .env.local.
DATABASE_URL="mysql://mi_monchis_admin:password@127.0.0.1:3306/mi_monchis_admin?serverVersion=8.4&charset=utf8mb4"

MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
DEFAULT_URI=http://127.0.0.1:8001

# Public catalog media storage. Keep real credentials in .env.local or the deployment secret store.
# Use CATALOG_MEDIA_STORAGE_PROVIDER=cloudflare_r2 in production.
CATALOG_MEDIA_STORAGE_PROVIDER=local
CATALOG_MEDIA_R2_ENDPOINT=
CATALOG_MEDIA_R2_REGION=auto
CATALOG_MEDIA_R2_BUCKET=
CATALOG_MEDIA_R2_ACCESS_KEY_ID=
CATALOG_MEDIA_R2_SECRET_ACCESS_KEY=
# Production CDN example: https://assets.mimonchis.mx
CATALOG_MEDIA_PUBLIC_BASE_URL=/media
CATALOG_MEDIA_UPLOAD_URL_TTL=900
CATALOG_MEDIA_MAX_IMAGE_BYTES=5242880
CATALOG_MEDIA_MAX_VIDEO_BYTES=52428800
